# The scan names repositories, and naming a repo as broken without
# showing up with a fix is a shame list. The aggregate report and the
# reproducible sample are published; the per-repo results stay local.
corpus/results.json
# The watch's state names customer repositories, and a private key is a
# private key. Neither belongs in a public repository, ever.
*.pem
watch-state.json
.vercel/

# Playwright MCP session artifacts (screenshots, snapshots, console logs)
.playwright-mcp/

# editor
.vscode/

# Loose screenshots from checking the site by eye. The ones the repo actually
# ships live under .github/; anything dropped at the root is a working file,
# and a 260KB PNG nobody references is not history. The site itself lives in
# nilaypatell/driftcite-landing now.
/*.png
/*.jpeg
/*.jpg
